FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-noto-core \
    fonts-noto-extra \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir fastapi "uvicorn[standard]" yt-dlp pydantic

ENV MEDIA_DIR=/tmp/media \
    PUBLIC_BASE="" \
    MAX_HEIGHT=1920 \
    MAX_UPLOAD_MB=120 \
    MEM_LIMIT_MB=900 \
    FONT_FILE=/usr/share/fonts/truetype/noto/NotoSansArabic-Regular.ttf \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY server.py .

EXPOSE 10000
CMD ["sh", "-c", "uvicorn server:app --host 0.0.0.0 --port ${PORT:-10000}"]
